        {
          "clave": "at_risk",
          "sql": "WITH cutoff AS (SELECT MAX(vta_fch) as max_date FROM legado.vtadia), stock_data AS (SELECT exi_art, SUM(exi_qty) as total_stock FROM legado.exidet WHERE exi_art = 'SKU-0036' GROUP BY exi_art), sales_data AS (SELECT vta_art, ROUND(SUM(vta_und)::numeric / 30, 2) as avg_daily_sales FROM legado.vtadia WHERE vta_art = 'SKU-0036' AND vta_fch >= (SELECT max_date FROM cutoff) - INTERVAL '30 days' AND vta_fch <= (SELECT max_date FROM cutoff) GROUP BY vta_art), sku_info AS (SELECT art_cd, art_crt, prv_dte FROM legado.artmst LEFT JOIN legado.prvmst ON art_prv = prv_id WHERE art_cd = 'SKU-0036') SELECT CASE WHEN sales.avg_daily_sales = 0 THEN 'No' WHEN sku.art_crt = false THEN 'No' WHEN ROUND(stock.total_stock::numeric / sales.avg_daily_sales, 2) < sku.prv_dte THEN 'Yes' ELSE 'No' END FROM sku_info sku LEFT JOIN stock_data stock ON sku.art_cd = stock.exi_art LEFT JOIN sales_data sales ON sku.art_cd = sales.vta_art",
