# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Semana 1: respaldos locales y dataset descargable
semana-01/*.bak-*
semana-01/input.txt
.env
semana-02/*.bak-*

# Jupyter
.ipynb_checkpoints/

# Semana 3: adaptadores de LoRA (pesados, se regeneran con mlx_lm.lora)
semana-03/adapters/
semana-03/resultados/prueba_*
.DS_Store
semana-04/entrenamiento/adapters/

# Semana 12: credenciales de nube nunca en el repo (se usan sesiones de CLI, perfiles e impersonación)
*.pem
*credentials*.json
*-key.json
*service-account*.json
.aws/

# Semana 12: ids de recursos de nube (locales)
semana-12/infra/estado_*.json
.claude/settings.local.json

# Archivos locales de trabajo (no se versionan)
.tmpcrop
.wt/
/path
.claude/

# Semana 14: secretos locales de Keycloak (los genera semana-14/auth/arrancar.sh)
semana-14/auth/.secretos.env

# Semana 17: secretos locales del stack de observabilidad y trazas crudas (pueden traer contenido de prompts)
semana-17/**/.secretos.env
semana-17/observabilidad/datos/

# Semana 18: los casos de pizarra sellados (solo sus huellas se versionan, en sellos.json)
semana-18/pizarra/.sellados/
